# Sistema PJN v6 - Environment Variables Example
# Copia este archivo a .env y completa con tus valores

# ===== General =====
# Entorno de ejecución (development, production, staging)
ENVIRONMENT=development

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===== Autenticación PJN =====
# Credenciales para acceder al Portal Judicial Nacional
PJN_USERNAME=tu_usuario
PJN_PASSWORD=tu_password

# URL de login (opcional, usa default si no se especifica)
# PJN_LOGIN_URL=https://portalpjn.pjn.gov.ar/inicio

# Timeout de sesión en segundos (default: 3600)
# PJN_SESSION_TIMEOUT_SECONDS=3600

# ===== Browser / Playwright =====
# Headless mode (true/false)
BROWSER_HEADLESS=true

# Timeout general en milisegundos (default: 30000)
# BROWSER_TIMEOUT_MS=30000

# Timeout de navegación en milisegundos (default: 60000)
# BROWSER_NAVIGATION_TIMEOUT_MS=60000

# ===== Storage / Almacenamiento =====
# Directorio base para datos (default: ./data)
# STORAGE_BASE_PATH=./data

# Nombre del archivo JSON base (todos los expedientes)
# STORAGE_JSON_BASE_FILE=expedientes_base.json

# Nombre del archivo JSON sistema (expedientes seleccionados)
# STORAGE_JSON_SISTEMA_FILE=expedientes_sistema.json

# Directorio de workspaces (relativo a base_path)
# STORAGE_WORKSPACES_DIR=workspaces

# Directorio de descargas (relativo a base_path)
# STORAGE_DOWNLOADS_DIR=descargas

# ===== Monitoreo Básico =====
# Intervalo entre verificaciones en segundos (0 = ejecutar una vez)
MONITOREO_INTERVALO_SEGUNDOS=1800

# Días hacia atrás para considerar expediente activo
# MONITOREO_DIAS_ACTIVIDAD=30

# Notificar cuando hay cambios
MONITOREO_NOTIFICAR_CAMBIOS=true

# Descargar archivos nuevos automáticamente
# MONITOREO_DESCARGAR_ARCHIVOS=true

# Máximo de reintentos en caso de error
MONITOREO_MAX_REINTENTOS=3

# Delay entre reintentos en segundos
# MONITOREO_REINTENTO_DELAY_SEGUNDOS=60

# ===== Monitoreo Avanzado (Compatibilidad v5.1.1) =====
# NOTA: Estas variables permiten configuración detallada de horarios
# similar a Sistema_v5.1.1. Son opcionales y sobrescriben el intervalo básico.

# Intervalos diferenciados en MINUTOS (laboral)
# MONITOREO_INTERVALOS_LABORAL_EXPEDIENTES=10
# MONITOREO_INTERVALOS_LABORAL_ENTRADAS=15

# Intervalos diferenciados en MINUTOS (no laboral)
# MONITOREO_INTERVALOS_NO_LABORAL_EXPEDIENTES=60
# MONITOREO_INTERVALOS_NO_LABORAL_ENTRADAS=30

# Días laborales (separados por coma)
# Opciones: lunes,martes,miercoles,jueves,viernes,sabado,domingo
# MONITOREO_DIAS_LABORALES=lunes,martes,miercoles,jueves,viernes

# Horario laboral (formato HH:MM)
# MONITOREO_HORA_INICIO=08:00
# MONITOREO_HORA_FIN=18:00

# Verificar expedientes y entradas
# MONITOREO_VERIFICAR_EXPEDIENTES=true
# MONITOREO_VERIFICAR_ENTRADAS=true

# Tipos de entradas a monitorear (N=Notificaciones, D=Demandas, separados por coma)
# MONITOREO_TIPOS_ENTRADAS=N

# Actualizar actuaciones automáticamente al detectar cambios
# MONITOREO_ACTUALIZAR_ACTUACIONES_AUTO=false

# Máximo de reintentos para actualización de actuaciones
# MONITOREO_MAX_REINTENTOS_ACTUALIZACION=2

# ===== FastAPI / API REST =====
# Puerto del servidor API
API_PORT=8000
API_HOST=0.0.0.0

# Secret key para JWT (generar con: openssl rand -hex 32)
API_SECRET_KEY=tu_secret_key_muy_segura_aqui_cambiar_en_produccion

# Algoritmo de encriptación JWT
API_ALGORITHM=HS256

# Tiempo de expiración del token (en minutos)
API_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS allowed origins (separados por coma)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== MCP Server =====
# Modo del servidor MCP (stdio, http)
MCP_MODE=stdio

# Puerto del servidor MCP (si modo http)
MCP_PORT=8001

# Workspace path para MCP (default: workspace)
# MCP_WORKSPACE_PATH=workspace

# Nombre del servidor MCP
# MCP_SERVER_NAME=sintaxis-actuaciones-v6

# Habilitar extracción de PDFs
# MCP_ENABLE_PDF_EXTRACTION=true

# Habilitar búsqueda de texto completo
# MCP_ENABLE_FULL_TEXT_SEARCH=true

# Habilitar estadísticas
# MCP_ENABLE_STATISTICS=true

# Límite de páginas por PDF
# MCP_MAX_PDF_PAGES=100

# Tamaño máximo de PDF en MB
# MCP_MAX_PDF_SIZE_MB=50

# ===== Base de Datos =====
# URL de la base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///./data/sistema.db

# Para PostgreSQL (futuro):
# DATABASE_URL=postgresql://user:password@localhost/sistemapjn

# ===== Redis (Cache) =====
# URL de Redis (si se usa)
REDIS_URL=redis://localhost:6379/0

# ===== Scraping / Timeouts =====
# NOTA: Configuración avanzada de timeouts (compatibilidad v5.1.1)

# Timeout por defecto en ms (default: 8000)
# SCRAPING_TIMEOUT_DEFAULT=8000

# Timeout para login en ms (default: 60000)
# SCRAPING_TIMEOUT_LOGIN=60000

# Timeout para descarga de archivos en ms (default: 30000)
# SCRAPING_TIMEOUT_DESCARGA=30000

# Máximo de páginas a extraer (null = sin límite)
# SCRAPING_MAX_PAGINAS_EXPEDIENTES=200

# Máximo de reintentos para descargas
# SCRAPING_MAX_REINTENTOS_DESCARGA=3

# ===== Workspace / Directorios =====
# Directorio base para workspace de expedientes
WORKSPACE_DIR=./data/expedientes

# Directorio para configuraciones
CONFIG_DIR=./config

# Directorio para datos del sistema
DATA_DIR=./data

# Directorios adicionales (creados automáticamente)
# - ./data/cache (caché del sistema)
# - ./data/descargas (archivos descargados)
# - ./data/logs (archivos de log)
# - ./data/monitor (datos del monitor)
# - ./data/reportes (reportes generados)
# - ./data/workspaces (workspaces de usuario)

# ===== Logging =====
# Nivel de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directorio de logs
# LOG_DIR=./data/logs

# Formato de log
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ===== Plugins =====
# Plugins habilitados (separados por coma)
ENABLED_PLUGINS=auth,notificaciones

# ===== Plugin: Notificaciones =====
# Email
NOTIF_EMAIL_ENABLED=false
NOTIF_EMAIL_SMTP_HOST=smtp.gmail.com
NOTIF_EMAIL_SMTP_PORT=587
NOTIF_EMAIL_USERNAME=tu_email@gmail.com
NOTIF_EMAIL_PASSWORD=tu_password_de_aplicacion
NOTIF_EMAIL_FROM=Sistema PJN <tu_email@gmail.com>
NOTIF_EMAIL_TO=destinatario@example.com

# Telegram
NOTIF_TELEGRAM_ENABLED=false
NOTIF_TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
NOTIF_TELEGRAM_CHAT_ID=tu_chat_id_aqui

# WhatsApp (via Twilio)
NOTIF_WHATSAPP_ENABLED=false
NOTIF_WHATSAPP_ACCOUNT_SID=tu_account_sid
NOTIF_WHATSAPP_AUTH_TOKEN=tu_auth_token
NOTIF_WHATSAPP_FROM=whatsapp:+14155238886
NOTIF_WHATSAPP_TO=whatsapp:+5491123456789

# ===== Plugin: IA Local / RAG System =====
# Ollama
IA_OLLAMA_ENABLED=true
IA_OLLAMA_HOST=http://localhost:11434
IA_OLLAMA_MODEL=llama3.2

# Qdrant Vector Database
RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
RAG_QDRANT_COLLECTION=actuaciones

# Embeddings Model
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RAG_EMBEDDING_DIMENSION=768

# spaCy NER Model
RAG_SPACY_MODEL=es_core_news_md

# Chunking Configuration
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=300

# Search Configuration
RAG_SEARCH_LIMIT=10
RAG_RERANK_TOP_K=5

# Cache
RAG_CACHE_DIR=./data/cache

# ===== Plugin: PDF Processing =====
# Tesseract path (Windows)
PDF_TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# Tesseract path (Linux/Mac)
# PDF_TESSERACT_CMD=/usr/bin/tesseract

# ===== Plugin: Oficios Digitales =====
# Path al certificado para firma digital
OFICIOS_CERT_PATH=./config/certificado.pem
OFICIOS_KEY_PATH=./config/private_key.pem

# ===== Development =====
# Recargar automáticamente en cambios
DEV_RELOAD=true

# Modo debug
DEBUG=true

# Mostrar queries SQL
SHOW_SQL_QUERIES=false

# ===== Testing =====
# Base de datos para tests
TEST_DATABASE_URL=sqlite:///:memory:

# Deshabilitar playwright headless en tests
TEST_PLAYWRIGHT_HEADLESS=false

# ===== Paths Absolutos (Opcional) =====
# Si necesitas paths absolutos en lugar de relativos, configúralos aquí
# BASE_DIR=/path/to/sistema_v6

# ===== Notas de Migración desde v5.1.1 =====
# Este archivo incluye variables equivalentes a Sistema_v5.1.1 para facilitar
# la migración. Las principales diferencias son:
#
# 1. Prefijos de variables:
#    - v5.1.1: SISTEMA_*, MCP_*, PJN_*
#    - v6:     MONITOREO_*, BROWSER_*, STORAGE_*, etc. (más específicos)
#
# 2. Monitoreo:
#    - v5.1.1: Intervalos complejos (laboral/no laboral, expedientes/entradas)
#    - v6:     Intervalo simple por defecto, opciones avanzadas disponibles
#
# 3. Directorios:
#    - v5.1.1: var/log, var/cache, workspace/inicial, etc.
#    - v6:     data/logs, data/cache, data/expedientes, etc.
#
# Ver ANALISIS_CONFIGURACION_V5.1.1.md para detalles completos.
