# Entorno virtual
.venv/
venv/
env/

# PyCharm y JetBrains
.idea/
*.iml

# Archivos de Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Archivos temporales
*.log
*.bak
*.backup
*.tmp
*.swp
*~

# Coverage files
.coverage
.coverage.*
htmlcov/
*.cover

# Configuraciones sensibles
*.env
!.env.example
Sistema_v5/config/credenciales.env

# Datos generados por el sistema
base_datos_simulada/
datos_extraidos/
backup_*/
data/
*/data/extraccion_inicial/
Sistema_v5/configuracion/gui/data/

# JSON files (allow config and test fixtures)
*.json
!Sistema_v5/config/sistema.json
!Sistema_v5/config/monitor.json
!Sistema_v5/tests/fixtures/**/*.json

# CSV data files
*.csv
!**/fixtures/**/*.csv

# Archivos comprimidos y exportaciones
*.zip
*.rar
*.7z
*.tar
*.gz

# Informes generados
*.pdf
*.docx
*.xlsx

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Playwright browser cache
.playwright/

# Logs de ejecución
Sistema_v5/logs/
logs/
*.log

# Datos de prueba
test_data/
temp/
